<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="underwater_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <uniform_fluid_density>1000</uniform_fluid_density>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="cascade">
      <pose>0 0 5 0 0 0</pose> <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
        <link_name>base_link</link_name>
        <xDotU>-4.876161</xDotU> <yDotV>-126.324739</yDotV> <zDotW>-126.324739</zDotW>
        <kDotP>0</kDotP> <mDotQ>-33.46</mDotQ> <nDotR>-33.46</nDotR>
        <xU>0</xU> <yV>0</yV> <zW>0</zW>
        <kP>-5.0</kP> <mQ>-33.46</mQ> <nR>-5.0</nR>
        <xUabsU>-6.2282</xUabsU> <yVabsV>-601.27</yVabsV> <zWabsW>-601.27</zWabsW>
        <kPabsP>-15.0</kPabsP> <mQabsQ>-632.698957</mQabsQ> <nRabsR>-632.698957</nRabsR>
      </plugin>

      <link name="base_link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>139.8671</mass> <inertia>
            <ixx>3.000000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>41.980233</iyy><iyz>0</iyz>
            <izz>41.980233</izz>
          </inertia>
        </inertial>
        <visual name="hull_visual">
          <pose>0 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
        </visual>
        <collision name="hull_collision">
          <geometry><box><size>2 0.3 0.246445166667</size></box></geometry>
        </collision>
      </link>

      <link name="propeller_fro"><pose>0.55 -0.3 0 0 0 0.52359</pose><inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia></inertial><visual name="v_fro"><geometry><box><size>0.03 0.1 0.03</size></box></geometry><material><ambient>0 0 1 1</ambient></material></visual></link>
      <joint name="propeller_fro_joint" type="revolute"><parent>base_link</parent><child>propeller_fro</child><axis><xyz>1 0 0</xyz></axis></joint>
      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster"><joint_name>propeller_fro_joint</joint_name><topic>/cascade/fro</topic><thrust_coefficient>1.0</thrust_coefficient><propeller_diameter>0.15</propeller_diameter><velocity_control>false</velocity_control></plugin>

      <link name="propeller_flo"><pose>0.55 0.3 0 0 0 -0.52359</pose><inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia></inertial><visual name="v_flo"><geometry><box><size>0.03 0.1 0.03</size></box></geometry><material><ambient>0 0 1 1</ambient></material></visual></link>
      <joint name="propeller_flo_joint" type="revolute"><parent>base_link</parent><child>propeller_flo</child><axis><xyz>1 0 0</xyz></axis></joint>
      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster"><joint_name>propeller_flo_joint</joint_name><topic>/cascade/flo</topic><thrust_coefficient>1.0</thrust_coefficient><propeller_diameter>0.15</propeller_diameter><velocity_control>false</velocity_control></plugin>

      <link name="propeller_bro"><pose>-0.55 -0.3 0 0 0 2.618</pose><inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia></inertial><visual name="v_bro"><geometry><box><size>0.03 0.1 0.03</size></box></geometry><material><ambient>0 0 1 1</ambient></material></visual></link>
      <joint name="propeller_bro_joint" type="revolute"><parent>base_link</parent><child>propeller_bro</child><axis><xyz>1 0 0</xyz></axis></joint>
      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster"><joint_name>propeller_bro_joint</joint_name><topic>/cascade/bro</topic><thrust_coefficient>1.0</thrust_coefficient><propeller_diameter>0.15</propeller_diameter><velocity_control>false</velocity_control></plugin>

      <link name="propeller_blo"><pose>-0.55 0.3 0 0 0 3.66519</pose><inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia></inertial><visual name="v_blo"><geometry><box><size>0.03 0.1 0.03</size></box></geometry><material><ambient>0 0 1 1</ambient></material></visual></link>
      <joint name="propeller_blo_joint" type="revolute"><parent>base_link</parent><child>propeller_blo</child><axis><xyz>1 0 0</xyz></axis></joint>
      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster"><joint_name>propeller_blo_joint</joint_name><topic>/cascade/blo</topic><thrust_coefficient>1.0</thrust_coefficient><propeller_diameter>0.15</propeller_diameter><velocity_control>false</velocity_control></plugin>

      <link name="propeller_fri"><pose>0.45 -0.2 0 0 0 0</pose><inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia></inertial><visual name="v_fri"><geometry><box><size>0.03 0.1 0.03</size></box></geometry><material><ambient>1 0 0 1</ambient></material></visual></link>
      <joint name="propeller_fri_joint" type="revolute"><parent>base_link</parent><child>propeller_fri</child><axis><xyz>0 0 1</xyz></axis></joint>
      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster"><joint_name>propeller_fri_joint</joint_name><topic>/cascade/fri</topic><thrust_coefficient>1.0</thrust_coefficient><propeller_diameter>0.15</propeller_diameter><velocity_control>false</velocity_control></plugin>

      <link name="propeller_fli"><pose>0.45 0.2 0 0 0 0</pose><inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia></inertial><visual name="v_fli"><geometry><box><size>0.03 0.1 0.03</size></box></geometry><material><ambient>1 0 0 1</ambient></material></visual></link>
      <joint name="propeller_fli_joint" type="revolute"><parent>base_link</parent><child>propeller_fli</child><axis><xyz>0 0 1</xyz></axis></joint>
      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster"><joint_name>propeller_fli_joint</joint_name><topic>/cascade/fli</topic><thrust_coefficient>-1.0</thrust_coefficient><propeller_diameter>0.15</propeller_diameter><velocity_control>false</velocity_control></plugin>

      <link name="propeller_bri"><pose>-0.45 -0.2 0 0 0 0</pose><inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia></inertial><visual name="v_bri"><geometry><box><size>0.03 0.1 0.03</size></box></geometry><material><ambient>1 0 0 1</ambient></material></visual></link>
      <joint name="propeller_bri_joint" type="revolute"><parent>base_link</parent><child>propeller_bri</child><axis><xyz>0 0 1</xyz></axis></joint>
      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster"><joint_name>propeller_bri_joint</joint_name><topic>/cascade/bri</topic><thrust_coefficient>-1.0</thrust_coefficient><propeller_diameter>0.15</propeller_diameter><velocity_control>false</velocity_control></plugin>

      <link name="propeller_bli"><pose>-0.45 0.2 0 0 0 0</pose><inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia></inertial><visual name="visual_bli"><geometry><box><size>0.03 0.1 0.03</size></box></geometry><material><ambient>1 0 0 1</ambient></material></visual></link>
      <joint name="propeller_bli_joint" type="revolute"><parent>base_link</parent><child>propeller_bli</child><axis><xyz>0 0 1</xyz></axis></joint>
      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster"><joint_name>propeller_bli_joint</joint_name><topic>/cascade/bli</topic><thrust_coefficient>1.0</thrust_coefficient><propeller_diameter>0.15</propeller_diameter><velocity_control>false</velocity_control></plugin>
      
      </model>
  </world>
</sdf>